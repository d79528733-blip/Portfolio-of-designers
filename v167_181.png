@media (max-width: 1439px) {
  html,
  body {
    width: 100%;
    min-width: 320px;
    overflow-x: hidden;
  }

  body {
    height: calc(3455px * (100vw / 1440px));
  }

  .v167_165 {
    width: 1440px;
    transform: scale(calc(100vw / 1440px));
    transform-origin: top left;
  }
}
